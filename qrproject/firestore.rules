rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'superAdmin']
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role;
    }
    function isSuperAdmin() { return isAdmin() && request.auth.token.role == 'superAdmin'; }
    match /products/{id} { allow read: if isAdmin(); allow write: if false; }
    match /categories/{id} { allow read: if isAdmin(); allow write: if false; }
    match /users/{id} { allow read: if isSuperAdmin() || (isAdmin() && request.auth.uid == id); allow write: if false; }
    match /invitations/{id} { allow read, write: if false; }
    match /imports/{id} {
      allow read: if isAdmin(); allow write: if false;
      match /rows/{rowId} { allow read: if isAdmin(); allow write: if false; }
    }
    match /skuIndex/{id} { allow read: if isAdmin(); allow write: if false; }
    match /scanLogs/{id} { allow read, write: if false; }
    match /scanDaily/{id} { allow read, write: if false; }
    match /scanRate/{id} { allow read, write: if false; }
    match /productStats/{id} { allow read: if isAdmin(); allow write: if false; }
    match /qrSettings/{id} { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
