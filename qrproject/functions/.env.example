# The Functions emulator reads functions/.env. Keep this file out of Git.
PUBLIC_BASE_URL=http://localhost:5173
SCAN_RATE_SALT=replace-with-a-random-secret
BOOTSTRAP_SECRET=replace-with-another-random-secret
# Optional when Firebase CLI login cannot provide cloud credentials:
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/service-account.json
# Optional: Mailtrap SMTP. Without these, invitation links are logged by the emulator.
MAILTRAP_HOST=
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=
MAIL_FROM=no-reply@example.test
# Optional additional frontend origins, comma-separated.
ALLOWED_ORIGINS=
